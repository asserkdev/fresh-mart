[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="items"
3d_physics/layer_5="vehicles"
3d_physics/layer_6="interactable"
3d_physics/layer_7="trigger"

[physics]

3d/default_gravity=9.8
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.3, 0.4, 0.3, 1)
